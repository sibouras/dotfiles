#|
guide: https://jtroo.github.io/config.html
source of all key names: https://github.com/jtroo/kanata/blob/main/parser/src/keys/mod.rs
|#

(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  concurrent-tap-hold yes
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc    NumLock
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \       kp7 kp8 kp9
  caps a    s    d    f    g    h    j    k    l    ;    '    ret          kp4 kp5 kp6
  lsft z    x    c    v    b    n    m    ,    .    /    rsft              kp1 kp2 kp3
  lctl lmet lalt           spc            ralt rmet rctl                   kp0 kp.
)

;; Variables
(defvar
 tap-time 100
 hold-time 100
)

(defalias
  cap (layer-while-held caps-layer)
  shit (multi lsft (layer-while-held shift-layer))
  td (tap-dance 150 (1 grv))
  atl (multi alt (layer-while-held alt-layer))
  mctl (multi lctl (layer-while-held lctl-layer))

  to-numpad (multi NumLock (layer-switch numpad-layer))
  to-base (multi NumLock (layer-switch base))
)

;; mmtp: tap middle mouse button

(deflayer base
  esc    f1    f2    f3    f4   f5   f6   f7   f8
  grv    1     2     3     4    5    6    7    8     bspc   0    -    =    bspc    @to-numpad
  tab    esc   w     e     r    t    y    u    i     o      p    [    ]    \       kp7  volu brup
  @cap   a     s     d     f    g    h    j    k     l      ;    '    ret          prev volu next
  @shit  z     x     c     v    b    n    m    ,     .      /    @shit             kp1  vold brdn
  @mctl  lmet  @atl             spc             ralt  rmet   rctl                  mute pp
)

(deflayer numpad-layer
  esc    f1    f2    f3    f4   f5   f6   f7   f8
  grv    1     2     3     4    5    6    7    8     bspc   0    -    =    bspc    @to-base
  tab    esc   w     e     r    t    y    u    i     o      p    [    ]    \       kp7 kp8 kp9
  @cap   a     s     d     f    g    h    j    k     l      ;    '    ret          kp4 kp5 kp6
  @shit  z     x     c     v    b    n    m    ,     .      /    @shit             kp1 kp2 kp3
  @mctl  lmet  @atl             spc             ralt  rmet   rctl                  kp0 kp.
)

(defalias
  mwu (mwheel-up  100 120)
  mwd (mwheel-down 100 120)
  pp (cmd playerctl play-pause)
  cm (cmd bash -c "echo hello world")
)

(deflayer caps-layer
  esc   f1    f2    f3    f4    pp    f6    prev  next
  grv   pp    vold  volu  mute  lrld  6     7     8       C-bspc  9     -     =    bspc    NumLock
  tab   q     C-w   @mwd  @mwu  C-t   y     pgup  home    end     pgdn  C-[   C-]  ins     _ _ _
  XX    lmet  lalt  lsft  lctl  menu  left  down  up      right   caps  del   ret          _ _ _
  lsft  z     x     mmtp  mlft  b     @pp   @cm   C-pgup  C-pgdn  /     rsft               _ _ _
  lctl  lmet  lalt              spc               ralt    rmet    rctl                     _ _
)

;; (deflayer shift-layer
;;   _  _  _
;;   _  _  _  _  _  _  _  _  _  lpar  _  _  _  _
;;   _  _  _  _  _  _  _  _  _  _     _  _  _  _
;;   _  _  _  _  _  _  _  _  _  _     _  _  _
;;   _  _  _  _  _  _  _  _  _  _     _  _
;;   _  _  _        _        _  _     _
;; )

(deflayermap shift-layer
  9 9
)

(deflayermap alt-layer
  i tab
  q f4
)

(deflayermap lctl-layer
  q q
)

;; Variables
(defvar
 chord-time 50
)

(defchordsv2
  ;; (participating-keys1) action1 timeout1 release-behaviour1 (disabled-layers1)
  (grv 1) mmtp $chord-time first-release ()
  ;; (1 2) vold $chord-time first-release ()
  ;; (2 3) volu $chord-time first-release ()
)
