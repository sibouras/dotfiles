#!/usr/bin/env bash

# https://github.com/aristocratos/btop

set -eu

TMP_DIR=$(mktemp --directory)
dra download -s "btop-x86_64-unknown-linux-musl.tar.gz" -o "$TMP_DIR/btop.tar.gz" aristocratos/btop
tar -xf "$TMP_DIR/btop.tar.gz" --directory="$TMP_DIR"
mkdir -p ~/src
cp -r "$TMP_DIR/btop" ~/src/
rm -r "$TMP_DIR"
cd ~/src/btop
sudo make install
