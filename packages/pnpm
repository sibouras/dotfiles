#!/usr/bin/env bash

# https://pnpm.io/installation

if command -v pnpm > /dev/null; then
  pnpm self-update
else
  curl -fsSL https://get.pnpm.io | sh -
fi

~/.local/share/pnpm/bin/pnpm completion bash > ~/.local/share/bash-completion/completions/pnpm
~/.local/share/pnpm/bin/pnpm completion zsh > ~/.local/share/zsh-completion/_pnpm
~/.local/share/pnpm/bin/pnpm completion fish > ~/.config/fish/completions/pnpm.fish
