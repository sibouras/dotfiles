#!/usr/bin/env bash

# https://github.com/bensadeh/tailspin

dra download -i -s "tailspin-x86_64-unknown-linux-musl.tar.gz" -o ~/.local/bin/tspin bensadeh/tailspin

tspin --completions bash > ~/.local/share/bash-completion/completions/tspin
tspin --completions zsh > ~/.local/share/zsh-completion/_tspin
tspin --completions fish > ~/.config/fish/completions/tspin.fish
