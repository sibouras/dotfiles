#!/usr/bin/env bash

# https://github.com/mierak/rmpc

set -eu

TMP_DIR=$(mktemp --directory)
dra download -s "rmpc-v{tag}-x86_64-unknown-linux-gnu.tar.gz" -o "$TMP_DIR/rmpc.tar.gz" mierak/rmpc
tar -xf "$TMP_DIR/rmpc.tar.gz" --directory="$TMP_DIR"
# binary
cp "$TMP_DIR/rmpc" ~/.local/bin/

# completions
cp "$TMP_DIR/completions/rmpc.bash" ~/.local/share/bash-completion/completions/rmpc
cp "$TMP_DIR/completions/_rmpc" ~/.local/share/zsh-completion/
cp "$TMP_DIR/completions/rmpc.fish" ~/.config/fish/completions/

# man page
mkdir -p ~/.local/share/man/man1
cp "$TMP_DIR/man/rmpc.1" ~/.local/share/man/man1/
rm -r "$TMP_DIR"
